# Copy to .env (gitignored) and replace every password. Docker Compose and the demo console read it.
HISTORY_DB=history
HISTORY_DB_USER=historian
HISTORY_DB_PORT=5433
HISTORY_DB_PASSWORD=change-me
# Grafana's read-only database login (created when the TimescaleDB volume is first initialized).
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-three
